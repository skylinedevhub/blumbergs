{
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/query", "dest": "api/query.py" },
    { "src": "/api/export", "dest": "api/export.py" },
    { "src": "/api/lookups", "dest": "api/lookups.py" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
